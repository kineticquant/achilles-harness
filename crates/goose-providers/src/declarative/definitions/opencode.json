{
  "name": "opencode",
  "engine": "openai",
  "display_name": "OpenCode Zen",
  "description": "OpenCode Zen models via OpenAI-compatible chat completions and the Responses API. Claude, Gemini, and Qwen on Zen use other protocols and are not listed here.",
  "api_key_env": "OPENCODE_API_KEY",
  "base_url": "https://opencode.ai/zen/v1",
  "headers": {
    "User-Agent": "Achilles"
  },
  "catalog_provider_id": "opencode",
  "dynamic_models": true,
  "skip_canonical_filtering": true,
  "model_doc_link": "https://opencode.ai/docs/zen",
  "preserves_thinking": true,
  "fast_model": "big-pickle",
  "models": [
    {"name": "big-pickle", "context_limit": 200000},
    {"name": "mimo-v2.5-free", "context_limit": 200000},
    {"name": "hy3-free", "context_limit": 190000},
    {"name": "nemotron-3-ultra-free", "context_limit": 1000000},
    {"name": "nemotron-3.5-lightning-free", "context_limit": 128000},
    {"name": "laguna-s-2.1-free", "context_limit": 256000},
    {"name": "deepseek-v4-flash-free", "context_limit": 200000},
    {"name": "muse-spark-1.2-contributor-free", "context_limit": 128000},
    {"name": "glm-5.2", "context_limit": 204800},
    {"name": "glm-5.1", "context_limit": 204800},
    {"name": "kimi-k2.6", "context_limit": 262144},
    {"name": "minimax-m3", "context_limit": 204800},
    {"name": "deepseek-v4-flash", "context_limit": 1000000}
  ],
  "supports_streaming": true,
  "setup_steps": [
    "Sign in at https://opencode.ai/zen",
    "Copy your OpenCode API key",
    "Paste the key above (the same key also works for OpenCode Go)"
  ]
}
